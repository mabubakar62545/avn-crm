<% content_for :title, "Security" %>

<div class="page-header">
  <div>
    <h1>Security</h1>
    <p>Manage where you're signed in and how you sign in.</p>
  </div>
</div>

<div class="stack">
  <section class="card card--flush" id="devices">
    <div class="card__title" style="padding:1.25rem 1.25rem 0">
      <h2>Signed-in devices</h2>
      <% if @sessions.size > 1 %>
        <%= button_to "Sign out all other devices", others_account_sessions_path, method: :delete, class: "btn btn--secondary btn--sm" %>
      <% end %>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>Device</th><th>IP address</th><th>Signed in</th><th>Last active</th><th class="actions"></th></tr>
        </thead>
        <tbody>
          <% @sessions.each do |s| %>
            <tr id="<%= dom_id(s) %>">
              <td>
                <strong><%= device_label(s.user_agent) %></strong>
                <div class="muted small" title="<%= s.user_agent %>"><%= s.user_agent.to_s.truncate(60) %></div>
              </td>
              <td class="nowrap"><%= s.ip_address.presence || "—" %></td>
              <td class="nowrap"><%= s.created_at.to_fs(:short) %></td>
              <td class="nowrap"><%= time_ago_in_words(s.last_active_at) %> ago</td>
              <td class="actions">
                <% if s == Current.session %>
                  <%= badge "This device", :info %>
                <% else %>
                  <%= button_to "Sign out", account_session_path(s), method: :delete, class: "btn btn--ghost btn--sm" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card" id="two_factor">
    <div class="card__title">
      <h2>Two-factor authentication</h2>
      <%= yes_no_badge(Current.user.otp_enabled?, yes: "On", no: "Off") %>
    </div>

    <% if Current.user.otp_enabled? %>
      <% remaining = Current.user.recovery_codes.unused.count %>
      <p>
        You'll be asked for a code from your authenticator app when you sign in.
        You have <strong><%= pluralize(remaining, "recovery code") %></strong> left.
      </p>
      <% if remaining <= 3 %>
        <div class="flash flash--alert">You're running low on recovery codes. Turn two-factor off and on again to get a new set.</div>
      <% end %>

      <h3 class="label">Turn off two-factor</h3>
      <%= form_with url: account_two_factor_path, method: :delete, class: "form-row", id: "disable_two_factor_form" do |f| %>
        <% if Current.user.password_set? %>
          <div class="field">
            <%= f.label :password, "Current password" %>
            <%= f.password_field :password, class: "input", required: true, autocomplete: "current-password" %>
          </div>
        <% end %>
        <div class="field">
          <%= f.label :code, "Authenticator or recovery code" %>
          <%= f.text_field :code, class: "input", required: true, autocomplete: "one-time-code", maxlength: 11 %>
        </div>
        <%= f.submit "Turn off two-factor", class: "btn btn--danger" %>
      <% end %>
    <% else %>
      <p>Add a second step to sign-in using an authenticator app such as 1Password, Google Authenticator or Authy.</p>
      <%= link_to "Turn on two-factor", new_account_two_factor_path, class: "btn" %>
    <% end %>
  </section>

  <section class="card" id="sign_in_methods">
    <div class="card__title"><h2>Sign-in methods</h2></div>
    <p>Link your Google account to sign in with one click next time.</p>

    <% google = Current.user.identities.find_by(provider: "google") %>
    <div class="row row--between">
      <div>
        <strong>Google</strong>
        <div class="muted small">
          <% if google %>
            Linked<%= " as #{google.email}" if google.email.present? %>
            <%= "· last used #{time_ago_in_words(google.last_used_at)} ago" if google.last_used_at %>
          <% else %>
            Not linked
          <% end %>
        </div>
      </div>
      <% if google && Current.user.can_unlink_identity? %>
        <%= button_to "Unlink", account_identity_path(google), method: :delete, class: "btn btn--ghost btn--sm" %>
      <% elsif google %>
        <span class="muted small" id="unlink_blocked">Set a password before you can unlink Google.</span>
      <% elsif sso_provider_enabled?(:google) %>
        <%= button_to "Link Google account", "/auth/google", method: :post, class: "btn btn--sm", data: { turbo: false } %>
      <% else %>
        <span class="muted small">Not available</span>
      <% end %>
    </div>
  </section>

  <section class="card">
    <div class="card__title"><h2>Password</h2></div>
    <% if Current.user.password_set? %>
      <p class="mb-0">To change your password, sign out and use
        <%= link_to "Forgot password", new_password_path %>. Changing it signs you out on all other devices.</p>
    <% else %>
      <p class="mb-0" id="password_not_set">You sign in with Google, so you don't have a password yet.
        To add one as a backup, <%= link_to "set a password", new_password_path(email_address: Current.user.email_address) %> — we'll email you a link.</p>
    <% end %>
  </section>
</div>
