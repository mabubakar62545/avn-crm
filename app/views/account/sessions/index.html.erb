<%# app/views/account/sessions/index.html.erb %>
<h1>Your devices</h1>
<table>
  <tr><th>Device</th><th>IP</th><th>Last active</th><th></th></tr>
  <% @sessions.each do |s| %>
    <tr>
      <td><%= s.user_agent.to_s.truncate(60) %></td>
      <td><%= s.ip_address %></td>
      <td><%= time_ago_in_words(s.last_active_at) %> ago</td>
      <td>
        <% if s == Current.session %>
          <strong>This device</strong>
        <% else %>
          <%= button_to "Sign out", account_session_path(s), method: :delete %>
        <% end %>
      </td>
    </tr>
  <% end %>
</table>
<%= button_to "Sign out all other devices", others_account_sessions_path, method: :delete %>