<% content_for :title, "Choose a new password" %>

<div class="card">
  <h1>Choose a new password</h1>
  <p class="muted">This signs you out on every device.</p>

  <%= form_with url: password_path(params[:token]), method: :put, class: "form", id: "password_update_form" do |form| %>
    <div class="field">
      <%= form.label :password, "New password" %>
      <%= form.password_field :password, class: "input", required: true, autofocus: true, autocomplete: "new-password", minlength: 12, maxlength: 72 %>
      <span class="hint">At least 12 characters.</span>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Repeat new password" %>
      <%= form.password_field :password_confirmation, class: "input", required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <%= form.submit "Save password", class: "btn btn--block" %>
  <% end %>
</div>
