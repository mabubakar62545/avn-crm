<% content_for :title, "Forgot password" %>

<div class="card">
  <h1>Forgot your password?</h1>
  <p class="muted">Enter your email and we'll send you a reset link.</p>

  <%= form_with url: passwords_path, class: "form", id: "password_reset_form" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, class: "input", required: true, autofocus: true, autocomplete: "username", placeholder: "you@company.com", value: params[:email_address] %>
    </div>
    <%= form.submit "Email reset instructions", class: "btn btn--block" %>
  <% end %>

  <div class="auth-links"><%= link_to "Back to sign in", new_session_path %></div>
</div>
