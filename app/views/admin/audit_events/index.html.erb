<% content_for :title, "Audit log" %>

<div class="page-header">
  <div>
    <h1>Audit log</h1>
    <p>
      Most recent 200 security events<%= " for #{@filtered_user.email_address}" if @filtered_user %>.
    </p>
  </div>
</div>

<section class="card" style="margin-bottom:1rem">
  <%= form_with url: admin_audit_events_path, method: :get, class: "form-row", id: "audit_filter_form", data: { turbo_action: "advance" } do |f| %>
    <%= f.hidden_field :user_id, value: params[:user_id] if params[:user_id].present? %>
    <div class="field">
      <%= f.label :event, "Event type" %>
      <%= f.select :event, options_for_select(@actions, params[:event]), { include_blank: "All events" }, class: "input" %>
    </div>
    <%= f.submit "Filter", class: "btn", name: nil %>
    <% if params[:event].present? || params[:user_id].present? %>
      <%= link_to "Clear filters", admin_audit_events_path, class: "btn btn--ghost" %>
    <% end %>
  <% end %>
</section>

<section class="card card--flush">
  <%= render "table", events: @events %>
</section>
