<% content_for :title, "Users" %>

<div class="page-header">
  <div>
    <h1>Users</h1>
    <p><%= pluralize(@users.size, "user") %></p>
  </div>
</div>

<% if policy(User).invite? %>
  <section class="card" style="margin-bottom:1rem">
    <div class="card__title"><h2>Invite someone</h2></div>
    <p class="muted">Employees and admins can only join by invitation. They get an email link to set a password or continue with Google.</p>
    <%= form_with scope: :invitation, url: admin_invitations_path, class: "form-row", id: "invite_user_form" do |f| %>
      <div class="field">
        <%= f.label :email_address, "Email" %>
        <%= f.email_field :email_address, class: "input", required: true, placeholder: "name@company.com" %>
      </div>
      <div class="field">
        <%= f.label :role %>
        <%= f.select :role, User::ROLES.reverse.map { |r| [ r.capitalize, r ] }, { selected: "manager" }, class: "input" %>
      </div>
      <%= f.submit "Send invitation", class: "btn" %>
    <% end %>
  </section>
<% end %>

<section class="card card--flush">
  <div class="table-wrap">
    <table class="table" id="users">
      <thead>
        <tr><th>Email</th><th>Role</th><th>Verified</th><th>Two-factor</th><th>Status</th><th>Devices</th><th>Joined</th></tr>
      </thead>
      <tbody>
        <% @users.each do |u| %>
          <tr id="<%= dom_id(u) %>">
            <td><%= link_to u.email_address, admin_user_path(u) %><%= " (you)" if u == Current.user %></td>
            <td><%= role_badge(u) %></td>
            <td><%= yes_no_badge(u.verified?) %></td>
            <td><%= yes_no_badge(u.otp_enabled?, yes: "On", no: "Off") %></td>
            <td><%= status_badge(u) %></td>
            <td><%= u.sessions.size %></td>
            <td class="nowrap"><%= u.created_at.to_date.to_fs(:short) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
