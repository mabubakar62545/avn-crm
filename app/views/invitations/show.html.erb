<% content_for :title, "Accept invitation" %>

<div class="card">
  <h1>Join AVN CRM</h1>
  <p class="muted">You've been invited as <strong><%= @user.role.capitalize %></strong>.
    Choose a password for <strong><%= @user.email_address %></strong>.</p>

  <%= form_with url: invitation_path(params[:token]), method: :patch, class: "form", id: "accept_invitation_form" do |f| %>
    <input type="text" name="username" value="<%= @user.email_address %>" autocomplete="username" hidden>
    <div class="field">
      <%= f.label :password %>
      <%= f.password_field :password, class: "input", required: true, autofocus: true, autocomplete: "new-password", minlength: 12, maxlength: 72 %>
      <span class="hint">At least 12 characters, and it can't contain your email name.</span>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, "Confirm password" %>
      <%= f.password_field :password_confirmation, class: "input", required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <%= f.submit "Accept invitation", class: "btn btn--block" %>
  <% end %>

  <% if sso_provider_enabled?(:google) %>
    <%= render "shared/sso_buttons", action: "Accept" %>
    <p class="muted small text-center">Use the Google account for <%= @user.email_address %>.</p>
  <% end %>
</div>
