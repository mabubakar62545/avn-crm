<% content_for :title, "Sign in" %>

<div class="card">
  <h1>Sign in</h1>
  <p class="muted">Welcome back. Sign in to continue.</p>

  <%= form_with url: session_path, class: "form", id: "sign_in_form" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, class: "input", required: true, autofocus: true, autocomplete: "username", placeholder: "you@company.com", value: params[:email_address] %>
    </div>
    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, class: "input", required: true, autocomplete: "current-password", maxlength: 72 %>
    </div>
    <%= form.submit "Sign in", class: "btn btn--block" %>
  <% end %>

  <%= render "shared/sso_buttons", action: "Sign in" %>

  <div class="auth-links">
    <%= link_to "Forgot password?", new_password_path %>
    <%= link_to "Didn't get the confirmation email?", new_email_verification_path %>
  </div>
</div>
<p class="text-center muted small" style="margin-top:1rem">
  New here? <%= link_to "Create an account", new_registration_path %>
</p>
