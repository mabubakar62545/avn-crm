<% if record.errors.any? %>
  <div class="flash flash--alert" role="alert" id="form_errors">
    <strong><%= pluralize(record.errors.count, "problem") %> to fix:</strong>
    <ul>
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
